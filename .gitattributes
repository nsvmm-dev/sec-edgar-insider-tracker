# Normalise line endings to LF in the repo and on checkout. The pipeline runs on
# Linux CI; keeping CRLF out avoids surprises in YAML, shell steps and the
# generated site (CNAME, robots.txt).
* text=auto eol=lf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
