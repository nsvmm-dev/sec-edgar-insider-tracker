# Copy to .env and fill in. .env is git-ignored.

# ---- Claude / Anthropic ----
# Required by the write / QA agents (agents/write_agent.py, agents/qa_agent.py).
ANTHROPIC_API_KEY=
# Model used by the write / QA agents. Default is the most capable model.
# For a high-volume 24/7 content pipeline you can lower cost significantly by
# switching to claude-sonnet-5 (roughly 1/2-1/3 the price) once quality is verified.
ANTHROPIC_MODEL=claude-opus-5

# ---- SEC EDGAR ----
# REQUIRED by SEC. Requests without a descriptive User-Agent get a 403.
# Format: "<app or site name> <contact email>" -- a bare email is not enough.
SEC_USER_AGENT="InsiderTrackerBot you@example.com"
# Delay between SEC requests in seconds (SEC limit is 10 req/s -> keep >= 0.11).
SEC_REQUEST_DELAY_SEC=0.15

# ---- Pipeline behaviour ----
# Ignore open-market trades whose total value is below this (USD). 0 = keep all.
MIN_TOTAL_VALUE_USD=100000
# Where per-day working files are written.
OUTPUT_DIR=./output
# Where approved articles are published (static-site content collection).
SITE_CONTENT_DIR=./site/src/content/articles
# S&P 500 ticker/CIK map used to filter filings.
SP500_CIKS_PATH=./data/sp500_ciks.json
# Dedupe ledger of already-published filings (keyed by SEC filing URL).
PUBLISHED_INDEX_PATH=./data/published_index.json

# ---- Phase 3+ (not required for Phase 1) ----
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
VERCEL_TOKEN=
X_API_KEY=
