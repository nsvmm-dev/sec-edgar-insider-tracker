---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE_NAME } from "../../consts.js";
import { titleCaseCompany, filerFromTitle } from "../../lib/format.js";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const company = titleCaseCompany(d.company) ?? d.company;
const verb = d.transaction_type === "purchase" ? "bought" : "sold";
// The headline carries a properly-cased name ("<Name> (<Title>) Buys ...");
// prefer it over the raw ALL-CAPS `filer` field from EDGAR.
const filer = filerFromTitle(d.title, d.filer);
const description = filer
  ? `${filer} ${verb} ${company ?? ""} (${d.ticker ?? ""}) stock on ${d.date}, per an SEC Form 4 filing.`
  : undefined;

const tickerHref = d.ticker ? `/ticker/${d.ticker.toLowerCase()}/` : undefined;

const usd = (n, decimals = 0) =>
  `$${Number(n).toLocaleString("en-US", {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals,
  })}`;

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: d.title,
  description,
  datePublished: d.date,
  dateModified: d.date,
  mainEntityOfPage: url,
  url,
  isBasedOn: d.source_url,
  author: { "@type": "Organization", name: SITE_NAME },
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", Astro.site).href,
    },
  },
};
---

<Base title={d.title} description={description} jsonLd={jsonLd}>
  <article class="prose">
    <h1>{d.title}</h1>
    <p class="muted">
      {company}{" "}
      {tickerHref ? <a href={tickerHref}>({d.ticker})</a> : d.ticker && `(${d.ticker})`}
      {" "}· Transaction date {d.date}
    </p>

    <dl class="fact-table">
      {filer && (
        <>
          <dt>Filer</dt>
          <dd>{filer}{d.filer_title ? ` — ${d.filer_title}` : ""}</dd>
        </>
      )}
      {d.transaction_type && (
        <>
          <dt>Transaction</dt>
          <dd>{d.transaction_type === "purchase" ? "Purchase" : "Sale"}</dd>
        </>
      )}
      {d.shares != null && (
        <>
          <dt>Shares</dt>
          <dd>{Number(d.shares).toLocaleString("en-US")}</dd>
        </>
      )}
      {d.price_per_share != null && (
        <>
          <dt>Price / share</dt>
          <dd>{usd(d.price_per_share, 2)}</dd>
        </>
      )}
      {d.total_value != null && (
        <>
          <dt>Total value</dt>
          <dd>{usd(Math.round(d.total_value))}</dd>
        </>
      )}
      <dt>Date</dt>
      <dd>{d.date}</dd>
    </dl>

    <Content />
    <p class="source-note">
      Source: <a href={d.source_url} rel="nofollow noopener" target="_blank"
        >SEC EDGAR filing</a
      >
    </p>
  </article>
  <p class="muted" style="margin-top:2rem"><a href="/">← All insider trades</a></p>
</Base>
