---
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../consts.js";
---

<Base
  title="Disclosure"
  description={`Advertising, affiliate and editorial disclosure for ${SITE_NAME}.`}
>
  <div class="static-page">
    <h1>Disclosure</h1>

    <h2>No investment advice</h2>
    <p>
      {SITE_NAME} is a news and information site. Nothing on it is investment,
      legal, tax or financial advice, or a recommendation to buy or sell any
      security. Insider transactions are disclosed for many reasons and do not
      indicate future stock performance. Always do your own research or consult a
      licensed financial adviser before making investment decisions.
    </p>

    <h2>Advertising</h2>
    <p>
      This site may display third-party advertising. Advertisements are labelled
      as such and are not endorsements. Ad partners may use cookies or similar
      technologies to serve and measure ads; see our{" "}
      <a href="/privacy/">Privacy Policy</a>.
    </p>

    <h2>Affiliate links</h2>
    <p>
      Some outbound links — for example to brokerage account sign-up pages — may
      be affiliate links. If you open an account or make a purchase through one,
      this site may earn a commission at no additional cost to you. Affiliate
      relationships never influence which insider transactions we cover or what a
      brief says; coverage is driven only by the filings.
    </p>

    <h2>Editorial independence</h2>
    <p>
      Briefs are generated from SEC filings by an automated pipeline. No
      advertiser or affiliate partner reviews or approves content before
      publication.
    </p>
  </div>
</Base>
