---
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../consts.js";
---

<Base
  title="Contact"
  description={`How to reach ${SITE_NAME} — corrections, removal requests, and general enquiries.`}
>
  <div class="static-page">
    <h1>Contact</h1>

    <p>
      Email: <a href="mailto:naka.kn007@gmail.com">naka.kn007@gmail.com</a>
    </p>

    <h2>Corrections</h2>
    <p>
      If a brief does not match the underlying SEC filing, send the page link and
      what is wrong. Confirmed errors are corrected or the brief is removed.
    </p>

    <h2>Removal requests</h2>
    <p>
      Briefs summarise public filings and link to the original. If you believe a
      page should be taken down, email the link and your reason and we will
      review it.
    </p>

    <h2>General enquiries</h2>
    <p>
      Press, partnership and advertising enquiries are welcome at the same
      address. This is a small, automated project, so replies may take a few
      days.
    </p>
  </div>
</Base>
