---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../consts.js";

const articles = (await getCollection("articles")).sort(
  (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: Astro.site?.href,
};
---

<Base title="Latest Insider Trades" jsonLd={jsonLd}>
  <h1>Latest Insider Trades</h1>
  <p class="muted">
    Short, fact-checked briefs on S&P 500 insider transactions, built from SEC
    Form 4 filings.
  </p>

  {articles.length === 0 && <p class="muted">No articles published yet.</p>}

  <ul class="article-list">
    {
      articles.map((a) => (
        <li>
          <a class="title" href={`/articles/${a.slug}/`}>
            {a.data.title}
          </a>
          <div class="muted">
            {[a.data.ticker, a.data.date].filter(Boolean).join(" · ")}
          </div>
        </li>
      ))
    }
  </ul>
</Base>
