---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TradeCard from "../components/TradeCard.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../consts.js";

const articles = (await getCollection("articles")).sort(
  (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: Astro.site?.href,
};
---

<Base title="Latest Insider Trades" jsonLd={jsonLd}>
  <Fragment slot="hero">
    <div class="hero">
      <h1>Latest Insider Trades</h1>
      <p>
        Short, fact-checked briefs on S&amp;P 500 insider transactions, built
        from SEC Form 4 filings.
      </p>
    </div>
  </Fragment>

  {articles.length === 0 && <p class="muted">No articles published yet.</p>}

  <ul class="trade-list">
    {
      articles.map((a) => (
        <li>
          <TradeCard article={a} />
        </li>
      ))
    }
  </ul>
</Base>
