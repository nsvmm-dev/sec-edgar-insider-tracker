---
// Subtle topographic contour-line texture for the navy header band -- the
// "hawk's-eye altitude" motif. Stretches to fill its container regardless of
// header height (slim nav-only band on inner pages, tall with the homepage
// hero), since the paths don't preserve aspect ratio.
---

<svg
  class="header-contour"
  viewBox="0 0 1232 320"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path
    d="M0 90 Q 200 50, 420 90 T 860 90 T 1232 90"
    fill="none"
    stroke="rgba(255,255,255,0.05)"
    stroke-width="2"
  ></path>
  <path
    d="M0 155 Q 220 115, 460 155 T 900 155 T 1232 155"
    fill="none"
    stroke="rgba(255,255,255,0.05)"
    stroke-width="2"
  ></path>
  <path
    d="M0 220 Q 240 185, 480 220 T 940 220 T 1232 220"
    fill="none"
    stroke="rgba(255,255,255,0.045)"
    stroke-width="2"
  ></path>
  <path
    d="M0 280 Q 260 250, 500 280 T 960 280 T 1232 280"
    fill="none"
    stroke="rgba(255,255,255,0.04)"
    stroke-width="2"
  ></path>
</svg>
