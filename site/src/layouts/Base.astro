---
import "../styles/global.css";
import { SITE_NAME, SITE_DESCRIPTION, CF_ANALYTICS_TOKEN } from "../consts.js";

const { title, description = SITE_DESCRIPTION, jsonLd } = Astro.props;

const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1E2A38" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    {
      CF_ANALYTICS_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M8 10 L11 4 L13 11 Z" fill="#f2b134"/>
          <path d="M24 10 L21 4 L19 11 Z" fill="#f2b134"/>
          <circle cx="16" cy="17" r="10" fill="#f2b134"/>
          <circle cx="12" cy="16" r="4.2" fill="#fff"/>
          <circle cx="20" cy="16" r="4.2" fill="#fff"/>
          <circle cx="12" cy="16" r="2" fill="#1e2a38"/>
          <circle cx="20" cy="16" r="2" fill="#1e2a38"/>
          <path d="M16 19 L14 23 L18 23 Z" fill="#e0592a"/>
        </svg>
        {SITE_NAME}
      </a>
      <nav>
        <a href="/">Latest</a>
        <a href="/weekly/">Weekly</a>
        <a href="/about/">About</a>
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <nav>
        <a href="/about/">About</a>
        <a href="/disclosure/">Disclosure</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/contact/">Contact</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <p>
        Independent information source — <strong>not affiliated with, endorsed
        by, or connected to</strong> the U.S. Securities and Exchange Commission
        or any government agency. Filing data is retrieved from the public SEC
        EDGAR system.
      </p>
      <p>
        Nothing on this site is investment advice. Insider transactions do not
        necessarily indicate future stock performance.
      </p>
      <p>© {year} {SITE_NAME}</p>
    </footer>
  </body>
</html>
