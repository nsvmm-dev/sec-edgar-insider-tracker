---
import "../styles/global.css";
import { SITE_NAME, SITE_DESCRIPTION, CF_ANALYTICS_TOKEN } from "../consts.js";

const { title, description = SITE_DESCRIPTION, jsonLd } = Astro.props;

const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1E2A38" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    {
      CF_ANALYTICS_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="17.28" r="9.92" fill="#f2b134"/>
          <path d="M4.48 9.28 L13.44 13.12 L11.84 16 L2.88 12.16 Z" fill="#e0592a"/>
          <path d="M27.52 9.28 L18.56 13.12 L20.16 16 L29.12 12.16 Z" fill="#e0592a"/>
          <circle cx="11.52" cy="16.64" r="3.04" fill="#1e2a38"/>
          <circle cx="20.48" cy="16.64" r="3.04" fill="#1e2a38"/>
          <circle cx="12.32" cy="15.84" r="0.83" fill="#fff"/>
          <circle cx="19.68" cy="15.84" r="0.83" fill="#fff"/>
          <path d="M16 17.92 C13.6 17.92 12 19.36 12.16 21.12 C12.29 22.4 13.28 23.84 14.72 24.8 C15.52 25.28 15.68 25.92 16.64 25.44 C18.08 24.48 19.52 22.56 19.68 20.8 C19.84 19.2 18.4 17.92 16 17.92 Z" fill="#e0592a"/>
        </svg>
        {SITE_NAME}
      </a>
      <nav>
        <a href="/">Latest</a>
        <a href="/weekly/">Weekly</a>
        <a href="/ticker/">Companies</a>
        <a href="/about/">About</a>
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <nav>
        <a href="/about/">About</a>
        <a href="/disclosure/">Disclosure</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/contact/">Contact</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <p>
        Independent information source — <strong>not affiliated with, endorsed
        by, or connected to</strong> the U.S. Securities and Exchange Commission
        or any government agency. Filing data is retrieved from the public SEC
        EDGAR system.
      </p>
      <p>
        Nothing on this site is investment advice. Insider transactions do not
        necessarily indicate future stock performance.
      </p>
      <p>© {year} {SITE_NAME}</p>
    </footer>
  </body>
</html>
