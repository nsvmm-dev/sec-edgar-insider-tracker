---
import "../styles/global.css";

const {
  title,
  description = "Plain-English news briefs on S&P 500 insider transactions (SEC Form 4).",
} = Astro.props;

const siteName = "Insider Trades";
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Insider Trades</a>
      <nav>
        <a href="/">Latest</a>
        <a href="/about/">About</a>
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <nav>
        <a href="/about/">About</a>
        <a href="/disclosure/">Disclosure</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/contact/">Contact</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <p>
        Independent information source — <strong>not affiliated with, endorsed
        by, or connected to</strong> the U.S. Securities and Exchange Commission
        or any government agency. Filing data is retrieved from the public SEC
        EDGAR system.
      </p>
      <p>
        Nothing on this site is investment advice. Insider transactions do not
        necessarily indicate future stock performance.
      </p>
      <p>© {year} Insider Trades</p>
    </footer>
  </body>
</html>
